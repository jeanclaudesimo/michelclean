# API Configuration
# Kopiere diese Datei zu .env.local und fülle die Werte aus

# Portal API URL
API_URL=http://portal.digitalssolutions.de

# Tenant API Key (von deinem Backend)
TENANT_API_KEY=YOUR_TENANT_API_KEY

# Login Credentials (für JWT Token-Generierung)
API_EMAIL=info@michelclean.de
API_PASSWORD=michelclean##123

# JWT Token für authentifizierte Endpoints (z.B. /api/config)
# Wird automatisch beim Login generiert oder manuell hier eintragen
JWT_TOKEN=YOUR_JWT_TOKEN

# Optional: Weitere API-Einstellungen
# API_TIMEOUT=5000
